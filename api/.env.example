# Valores de DESENVOLVIMENTO. Copie para .env (que é ignorado pelo git): cp .env.example .env

DB_USER=root
# Também vira MYSQL_ROOT_PASSWORD no container do banco (não pode ser vazia).
DB_PASS=devbook_dev
DB_NAME=devbook

# Usados quando a API roda FORA do docker (go run). Dentro do compose,
# a API sempre fala com db:3306; DB_PORT aqui é a porta publicada no host.
DB_HOST=127.0.0.1
DB_PORT=3310

API_PORT=5000
SECRET_KEY=troque-esta-chave-de-desenvolvimento

# Origem do front liberada no CORS (padrão: Vite em http://localhost:5173)
CORS_ORIGIN=http://localhost:5173
